# Server
PORT=3000
NODE_ENV=development

# MongoDB Atlas (Mongoose). Replace with your cluster connection string.
# Atlas > Connect > Drivers > copy the URI and add the database name before the "?".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>.mongodb.net/estudio_juridico?retryWrites=true&w=majority

# Auth (JWT)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Session cookie only over HTTPS. Defaults to true when NODE_ENV=production.
# Set it to false only for local development over plain HTTP.
# COOKIE_SECURE=false
# Failed login attempts allowed per IP within the window.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
# Comma-separated origins allowed to call the API cross-origin. Empty = same origin only.
CORS_ORIGINS=

# Logging
LOG_DIR=logs

# First firm owner, read only by `npm run create-titular` (production install). The password is temporary:
# the owner must change it on first login. Remove these values once the owner exists.
# TITULAR_NOMBRE=
# TITULAR_EMAIL=
# TITULAR_PASSWORD=